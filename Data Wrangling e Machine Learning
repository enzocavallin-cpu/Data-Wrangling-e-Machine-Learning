def conversao(arquivos_venda): # Função de conversão dos arquivos.
    
    tabela_planilha = [] # Lista vazia onde serão guardados os dados de venda.

    for arquivo in arquivos_venda: # Iteração sobre os arquivos da variável "arquivo_venda".
        
        if arquivo.name.endswith('.xls'): # Procura apenas os arquivos .xls.
            
            try: # Para certificar que o código não quebre caso algum arquivo .xls esteja corrompido ou ilegível.
                    vendas = pd.read_excel(
                        arquivo.path, 
                        engine='xlrd',
                        engine_kwargs={'ignore_workbook_corruption': True}
                    ) # Método da biblioteca Pandas de "upload" de dados de arquivos excel para o formato "DataFrame".
                    tabela_planilha.append(vendas) # Adiciona os dados da planilha atual ao final da lista "tabela_planilha".
            except Exception as e:
                print(f"Erro ao ler o arquivo {arquivo.name}: {e}") # Alerta caso algum arquivo .xls não possa ser lido.

    if not tabela_planilha:
        raise ValueError("Nenhum arquivo .xls foi encontrado ou lido com sucesso na pasta.") # Alerta caso nenhum arquivo .xls tenha sido lido.
        
    return pd.concat(tabela_planilha, ignore_index=True) # Resultado da função "conversao()".
    
