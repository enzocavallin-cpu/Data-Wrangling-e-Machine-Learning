def metricas(real, previsto): # Calcula MAE, RMSE, WAPE e viés das previsões mensais agregadas.
    erro = real - previsto
    return {
        'MAE': erro.abs().mean(),
        'RMSE': np.sqrt((erro ** 2).mean()),
        'WAPE': erro.abs().sum() / real.sum(),
        'Viés': (previsto.sum() - real.sum()) / real.sum() # Negativo: o modelo prevê abaixo do real.
    }

