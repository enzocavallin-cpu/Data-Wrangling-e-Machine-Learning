#%% VARIÁVEIS DE TAMANHO, COR E NOME DO PRODUTO
tamanhos = re.compile(
    r'^(PP|P|M|G|GG|GG1|GG2|GG3|GG4|XG|XXG|X1|X2|X3|X+G?|XX\d+|\d{2}|ÚNICO|U)$',
    re.IGNORECASE
    ) # Expressão regular para indicar os formatos de tamanho possíveis de serem encontrados no DF.

def con_tamanho(x): # Função retorna "True" caso a "string" em análise tenha correspondência com a expressão regular.
    if pd.isna(x):
        return False
    
    return bool(tamanhos.match(str(x).strip()))

def separar_variaveis(texto): # Função para separar a célula "produto" em: nome do produto; cor; e tamanho.
    partes = texto.split(' - ') # Delimitador guia para separação.
    
    produto = partes[0] # Primeira string antes do hífen vai ser o nome do produto.
    cor = None # variável "cor" com valor "None".
    tamanho = None # variável "tamanho" com valor "None".
    
    for parte in partes[1:]: # Iteração sobre cada indíce da "string" 
        if con_tamanho(parte): # Aplicação da função para retornar "True" caso seja um tamanho
            tamanho = parte # Se for um tamanho, então a "string" se torna uma categoria da variável
        else:
            cor = parte if cor is None else f"{cor} - {parte}" # Caso não seja um tamanho, então ela só pode ser uma cor.
    
    return pd.Series([produto, cor, tamanho]) # Resultado da função.
    
