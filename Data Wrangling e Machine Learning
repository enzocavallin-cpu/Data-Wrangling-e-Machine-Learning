#%% TESTE DE VUONG E SCORE PARA EXCESSO DE ZEROS

ll_bneg = modelo_bneg.model.loglikeobs(modelo_bneg.params.values) # Calula o LL do modelo BNEG.
ll_zinb = modelo_zinb.model.loglikeobs(modelo_zinb.params.values) # Calula o LL do modelo ZINB.

m = ll_bneg - ll_zinb # Calcula a diferença de LL entre os dois modelos.
n = len(m) # Guarda a quantidade total de observações (linhas) presentes na série de diferenças.
vuong_stat = np.sqrt(n) * (np.mean(m) / np.std(m, ddof=1)) # Calcula a estatística do Teste de Vuong.

